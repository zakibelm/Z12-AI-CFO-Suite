# ============================================================
# Z12 AI CFO Suite — Backend Environment Variables
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS COMMITTER .env dans git
# ============================================================

# --- IA / LLM ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DEFAULT_MODEL=anthropic/claude-sonnet-4-5
OLLAMA_HOST=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_TIMEOUT=120
HF_API_TOKEN=

# --- Auth ---
AUTH_MODE=local
SESSION_JWT_SECRET=change-me-random-256bit-secret
SESSION_TTL_HOURS=24
TOKEN_ENC_KEY=change-me-random-32-chars-key-xx

# --- Google OAuth (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cfo.yourdomain.com/auth/google/callback
GOOGLE_SCOPES=openid email profile

# --- Base de données ---
DATABASE_URL=postgresql://user:password@db:5432/z12cfo
SUPABASE_JWT_SECRET=

# --- Frontend ---
FRONTEND_URL=https://cfo.yourdomain.com

# --- Cache ---
CACHE_MAX_ENTRIES=500
CACHE_TTL_HOURS=24
SLIDING_WINDOW_SIZE=20

# --- WhatsApp Twilio (optionnel) ---
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_WHITELIST=+15141234567,+15149876543

# --- Logging ---
LOG_LEVEL=INFO
