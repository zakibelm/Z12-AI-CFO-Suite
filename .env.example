# ============================================================
# Z12 AI CFO — .env.example
# Copier vers .env et remplir toutes les valeurs obligatoires
# NE JAMAIS committer .env dans Git
# ============================================================

# ── Identité de l'instance ────────────────────────────────
COMPANY_NAME=Cabinet Comptable XYZ
PUBLIC_URL=https://votre-domaine.com

# ── Administrateur ────────────────────────────────────────
ADMIN_EMAIL=admin@votre-cabinet.com
ADMIN_PASSWORD=ChangerCeMotDePasse2024!

# ── Secrets cryptographiques ──────────────────────────────
# Générer avec : openssl rand -hex 32
JWT_SECRET=REMPLACER_PAR_openssl_rand_hex_32
SECRET_KEY=REMPLACER_PAR_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Base de données PostgreSQL ────────────────────────────
POSTGRES_USER=ai_cfo
POSTGRES_PASSWORD=REMPLACER_PAR_openssl_rand_hex_16
POSTGRES_DB=ai_cfo_db
DATABASE_URL=postgresql://ai_cfo:POSTGRES_PASSWORD@db:5432/ai_cfo_db

# ── Intelligence artificielle ─────────────────────────────
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REMPLACER_PAR_VOTRE_CLE
DEFAULT_MODEL=anthropic/claude-3-haiku
BANK_RECONCILIATION_MODEL=anthropic/claude-3-opus
BANK_RECONCILIATION_TEMPERATURE=0

# ── CORS et origines autorisées ───────────────────────────
ALLOWED_ORIGINS=https://votre-domaine.com,http://localhost:3000

# ── WhatsApp (optionnel) ──────────────────────────────────
WHATSAPP_MODE=twilio_api
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=REMPLACER_PAR_TOKEN_TWILIO
TWILIO_FROM=whatsapp:+14155238886
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_WHITELIST=+1XXXXXXXXXX

# ── Email / Notifications (optionnel) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@votre-cabinet.com
SMTP_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_APP
SMTP_FROM=Z12 AI CFO <notifications@votre-cabinet.com>

# ── OAuth (optionnel) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Monitoring (optionnel) ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Backup automatique ────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/z12-cfo

# ── Conformite Loi 25 (Quebec) ───────────────────────────
INSTANCE_ID=z12-cfo-REMPLACER_PAR_NOM_CLIENT
PRIVACY_OFFICER_EMAIL=responsable@votre-cabinet.com

# ── Environnement ─────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ============================================================
# CHECKLIST AVANT DEMARRAGE
# ============================================================
# [ ] JWT_SECRET et SECRET_KEY : openssl rand -hex 32
# [ ] POSTGRES_PASSWORD : openssl rand -hex 16
# [ ] OPENROUTER_API_KEY remplie et testee
# [ ] PUBLIC_URL et ALLOWED_ORIGINS = vrai domaine/IP
# [ ] ADMIN_EMAIL et ADMIN_PASSWORD personnalises
# [ ] .env dans .gitignore (ne jamais committer)
# [ ] INSTANCE_ID unique par client (Loi 25)
# ============================================================
